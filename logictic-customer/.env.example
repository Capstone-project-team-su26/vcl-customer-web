# ------------------------------------------------------------------
# Sao chép file này thành .env nếu cần. App chạy được khi không có .env —
# mọi biến dưới đây đều là tùy chọn. Không có .env thì các module đã nối
# API thật gọi thẳng backend production (xem VITE_API_BASE_URL bên dưới).
#
# Mọi biến VITE_* đều bị nhúng vào bundle và người dùng cuối đọc được —
# tuyệt đối không đặt bí mật phía server vào đây.
#
# Chỉ liệt kê biến CÒN ĐƯỢC ĐỌC trong src/. Kiểm chứng:
#   grep -rn "import.meta.env" src/
# ------------------------------------------------------------------

# Google OAuth. Thiếu -> nút "Đăng nhập bằng Google" bị thay bằng nút dự phòng
# dán tay idToken. Đăng nhập bằng email/mật khẩu vẫn chạy bình thường.
# Đọc ở: src/app/providers/AppProviders.jsx, src/features/auth/pages/Login/Login.jsx
VITE_GOOGLE_CLIENT_ID=

# Trợ lý AI trong khung chat nổi (FloatingChat) — fetch thẳng tới endpoint AI,
# không đi qua backend VCL.
# Thiếu endpoint hoặc key -> khung chat báo "Trợ lý AI chưa được cấu hình",
# phần còn lại của ứng dụng vẫn chạy bình thường.
# Đọc ở: src/shared/config/aiConfig.js
VITE_CODEX_ENDPOINT=
VITE_CODEX_API_KEY=
VITE_CODEX_MODEL=gpt-5.4-mini

# Gốc backend VCL. Đọc ở hai chỗ, mỗi chỗ có giá trị dự phòng riêng khi
# biến bỏ trống:
#   - src/shared/api/httpClient.js — base URL của mọi lời gọi API thật (đăng nhập,
#     hồ sơ, đơn ký gửi, báo giá + cọc, dữ liệu form, upload ảnh, hàng cấm). Bỏ
#     trống -> https://vcl.henrytech.cloud (production). Dấu "/" cuối bị cắt.
#     QuotationDetail.helpers.js dùng lại API_BASE_URL này cho URL SePay tương đối.
#   - src/features/purchase/api/purchaseRequestApi.js — chỉ để dựng URL checkout
#     SePay khi API trả đường dẫn TƯƠNG ĐỐI (luồng mua hộ vẫn là mock). Bỏ trống
#     -> vẫn rơi về https://api-vcl.zushin.io.vn.
VITE_API_BASE_URL=https://vcl.henrytech.cloud

# ------------------------------------------------------------------
# KHÔNG được đọc ở đâu trong src/:
#   VITE_API_ADDRESS_URL      (addressApi vẫn là mock, đọc src/mocks/data/addresses.js)
#   VITE_UPLOAD_API_BASE_URL  (uploadImage dùng chung base URL của httpClient)
# ------------------------------------------------------------------
